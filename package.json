{
  "name": "reciclaje-zuame-alisos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "tsx server/index.ts",
    "dev:cloudflare": "npm run build && wrangler pages dev dist --d1=DB",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "express": "^5.0.0",
    "dotenv": "^17.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0",
    "@cloudflare/workers-types": "^5.20261101.1"
  }
}
